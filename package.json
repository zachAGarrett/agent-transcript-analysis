{
  "name": "workstream-tokens",
  "description": "Tag Cursor agent transcripts and learn lattice patterns with @khoralabs/tkn.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream",
    "visualize": "bun run --filter @workstream/explorer start",
    "service": "bun run --filter @workstream/service start",
    "service:cli": "bun run --filter @workstream/service cli",
    "service:emit": "bun run --filter @workstream/service emit"
  },
  "dependencies": {
    "@khoralabs/agent-review": "^0.2.2",
    "@khoralabs/tkn": "^0.2.1",
    "@workstream/host": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
