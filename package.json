{
  "name": "workstream-tokens",
  "description": "Tag Cursor agent transcripts and learn lattice patterns with @khoralabs/tkn.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "biome": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky",
    "cli": "bun cli/index.ts",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream",
    "visualize": "bun app/visualize.ts"
  },
  "bin": {
    "cli": "./cli/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@khoralabs/agent-review": "^0.2.2",
    "@khoralabs/tkn": "^0.2.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
