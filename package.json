{
  "name": "workstream-tokens",
  "description": "Tag Cursor agent transcripts and learn lattice patterns with @khoralabs/tkn.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "vendor/statespace/packages/*"
  ],
  "scripts": {
    "biome": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:viz": "tsc --noEmit -p visualizations",
    "test": "bun test",
    "prepare": "husky",
    "submodules:init": "git submodule update --init --recursive",
    "cli": "bun cli/index.ts",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream",
    "visualize": "bun visualizations/server.ts"
  },
  "bin": {
    "cli": "./cli/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@khoralabs/agent-review": "^0.2.2",
    "@khoralabs/tkn": "^0.1.0",
    "@statespace/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
